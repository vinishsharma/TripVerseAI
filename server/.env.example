# Local Express server port
PORT=8081

# Browser address allowed to call this API during local development
CLIENT_URL=http://localhost:5173

# Replace the placeholders locally. Never commit the real value.
MONGODB_URI=mongodb+srv://tripverse_app:YOUR_URL_ENCODED_PASSWORD@cluster-name.mongodb.net/tripverse_ai?retryWrites=true&w=majority&appName=Cluster0

# Generate a separate high-entropy value for this; never use a human password.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Gemini is used only by the backend to generate structured itineraries.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
